{
  "name": "discord-gnomo-bot",
  "version": "1.0.2",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --tsconfig tsconfig.nest.json src/database/migrate.ts",
    "memory:migrate": "tsx --tsconfig tsconfig.nest.json src/memory-migration/cli.ts",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "launch": "flyctl launch",
    "deploy": "fly deploy --ha=false",
    "fly:redis": "fly redis connect",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "ts:check": "npx tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.nest.json --test test/*.test.ts",
    "lint:check": "eslint src test",
    "verify": "npm test && npm run ts:check && npm run build && npm run lint:check",
    "measure:live": "tsx --tsconfig tsconfig.nest.json src/conversation/live-measurement.ts",
    "sandbox": "nest start --entryFile console",
    "sandbox:watch": "nest start --entryFile console --watch",
    "notices:transfer": "tsx --tsconfig tsconfig.nest.json scripts/transfer-pilot-reminders.ts"
  },
  "author": "Matias Diez-Canseco",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.12",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/terminus": "^11.0.0",
    "ai": "^6.0.39",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "htmlparser2": "^12.0.0",
    "ioredis": "^5.9.2",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.20.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
