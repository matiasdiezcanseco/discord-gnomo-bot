# Safe default. Active modes require operator-controlled rollout; see docs/runtime-transition.md.
RUNTIME_MODE=paused
RUNTIME_CHANNEL_IDS=
CONVERSATION_CONCURRENCY=4
# Explicit deployment identity retained from the previous example; fallback stays gpt-4o-mini.
OPENAI_MODEL=gpt-5-mini
NODE_ENV=development
LOG_LEVEL=info
# Include redacted request/reply text in conversation traces (see docs/debugging.md).
# LOG_CONTENT=true
PORT=3000
# Local host process; Docker Compose substitutes service names inside the bot container.
# Local-only credentials. Deployment supplies the Neon (or Supabase) URL instead.
DATABASE_URL=postgresql://gnomo:gnomo-local@127.0.0.1:5432/gnomo
# Production Neon pooled endpoint; runtime prefers it, migration commands use DATABASE_URL.
# DATABASE_URL_POOLED=postgresql://owner:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
# PILOT_MEMORY_DATABASE_URL remains supported as a fallback alias.
# Reuse the existing local Redis, in a separate logical database for the local pilot.
REDIS_URL=redis://:gnomo123@127.0.0.1:6379/15
# Uncomment and supply for pilot/guild mode (one configured guild, one process).
# BOT_TOKEN=...
# GUILD_ID=...
# OPENAI_API_KEY=...
# Image creation (needs OPENAI_API_KEY and REDIS_URL): max 1 image per user per hour.
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=medium
# Voice messages (needs OPENAI_API_KEY and REDIS_URL): max 1 audio per user per cooldown.
# Realtime API model (gpt-4o-mini-tts/tts-1 shut down 2027-01-06); voice marin or cedar is best.
# OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
# OPENAI_SPEECH_VOICE=cedar
# OPENAI_SPEECH_COOLDOWN_MINUTES=10
# Optional capabilities: omit absent values instead of setting empty credentials/URLs.
# BUCKET_URL=https://your-approved-bucket/
# Media library (save/share images): any public-read S3-compatible bucket. `fly storage create
# --public` sets these five on the Fly app (Tigris). Also needs the database and MEMORY_OWNER_ID.
# BUCKET_NAME=gnomo-media
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=tid_...
# AWS_SECRET_ACCESS_KEY=tsec_...
# Public base for object URLs; defaults to https://<BUCKET_NAME>.t3.tigrisfiles.io/
# MEDIA_PUBLIC_URL=
# BROWSERBASE_API_KEY=bb_live_...
# GNOMOS_CHANNEL_ID=123456789012345678
# Deployment: DATABASE_URL is the direct Neon URL; DATABASE_URL_POOLED is the pooled URL.
# See docs/local-testing.md for verified TLS and schema setup.
# MEMORY_OWNER_ID=123456789012345678
# PILOT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
