# Local sandbox: the production runtime with the terminal instead of Discord.
# Copy to .env.sandbox (git-ignored). Load order: shell > .env.sandbox > .env.local > .env,
# so anything not set here (API keys, BUCKET_URL, MEMORY_OWNER_ID…) comes from your .env.
# Database/Redis URLs must point to local hosts; startup refuses anything else.

# Admit every channel of the (local) server, as production in guild mode.
RUNTIME_MODE=guild

# Local storage only. Empty values block production URLs that may exist in .env.
DATABASE_URL=postgresql://gnomo:gnomo-local@127.0.0.1:5432/gnomo
DATABASE_URL_POOLED=
PILOT_MEMORY_DATABASE_URL=
# Logical DB 14: claims/reminders separate from the local Discord pilot (15).
REDIS_URL=redis://:gnomo123@127.0.0.1:6379/14

# Same providers as production (fill here or keep them in .env).
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5-mini
# TAVILY_API_KEY=...
# BUCKET_URL=https://your-approved-bucket/
# MEMORY_OWNER_ID=123456789012345678
# PILOT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Optional console identity (17–20 digit IDs). Defaults: GUILD_ID or a local ID,
# the user is MEMORY_OWNER_ID (so owner-only memory works) and the channel is GNOMOS_CHANNEL_ID.
# GUILD_ID=123456789012345678
# SANDBOX_CHANNEL_ID=123456789012345678
# SANDBOX_USER_ID=123456789012345678
# SANDBOX_USERNAME=matias
# SANDBOX_BOT_USERNAME=Gnomo
# Extra members for member lists and @mentions: id:name,id:name
# SANDBOX_MEMBERS=111111111111111111:ana,222222222222222222:bruno
LOG_LEVEL=info
# Logs go to this file, not the chat terminal (`stdout` keeps them inline).
# SANDBOX_LOG_FILE=sandbox.log
